# Super Debug Cloud — Backend environment
# Copy to `.env` and fill in real values. Never commit `.env`.

# Server
PORT=3000
# Public base path/URL where this API is reachable (used in docs + CORS notes)
SERVER_BASE_PATH=http://localhost:3000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/superdebug

# Auth
# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Domain & CORS Configuration
LOCAL_DOMAIN=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:5173
PRODUCTION_DOMAIN=https://proxytea.hatchable.site,https://proxytea.com,https://app.proxytea.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,https://proxytea.hatchable.site,https://proxytea.com


# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM="ProxyTea <your-email@gmail.com>"

